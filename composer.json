{
  "name": "tangible/populater",
  "description": "WordPress plugin to populate a WP site with LMS content for testing and development.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1",
    "deliciousbrains/wp-background-processing": "^1.4"
  },
  "require-dev": {
    "brain/monkey": "^2.6",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
    "mockery/mockery": "^1.6",
    "php-stubs/wp-cli-stubs": "^2.12",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.3",
    "phpunit/phpunit": "^10.5",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "wp-coding-standards/wpcs": "^3.4",
    "yoast/phpunit-polyfills": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "Tangible\\Populater\\LMS\\": "src/LMS/",
      "Tangible\\Populater\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tangible\\Populater\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:coverage": "phpunit --coverage-text",
    "test:integration": "phpunit -c phpunit.integration.xml",
    "docker:test": "docker compose exec wp-test bash -c 'composer test'",
    "docker:test:coverage": "docker compose exec -e XDEBUG_MODE=coverage wp-test bash -c 'composer test:coverage'",
    "docker:test:integration": "docker compose exec wp-test bash -c 'composer test:integration'",
    "k6:lifter": "bash scripts/k6-run.sh run lifterlms-stress.js",
    "k6:lifter:smoke": "K6_PROFILE=smoke bash scripts/k6-run.sh run lifterlms-stress.js",
    "k6:lifter:clean-race": "K6_PROFILE=clean-race-100 bash scripts/k6-run.sh run lifterlms-stress.js",
    "k6:lifter:breakpoint": "K6_PROFILE=breaking-point-arrival bash scripts/k6-run.sh run lifterlms-stress.js",
    "k6:lifter:knee": "K6_PROFILE=stress-knee bash scripts/k6-run.sh run lifterlms-stress.js",
    "k6:learndash": "bash scripts/k6-run.sh run learndash-stress.js",
    "k6:learndash:smoke": "K6_PROFILE=smoke bash scripts/k6-run.sh run learndash-stress.js",
    "k6:learndash:clean-race": "K6_PROFILE=clean-race-100 bash scripts/k6-run.sh run learndash-stress.js",
    "k6:learndash:breakpoint": "K6_PROFILE=breaking-point-arrival bash scripts/k6-run.sh run learndash-stress.js",
    "k6:learndash:knee": "K6_PROFILE=stress-knee bash scripts/k6-run.sh run learndash-stress.js",
    "zip": "bash scripts/zip.sh",
    "lint": "phpcs",
    "lint:fix": "phpcbf",
    "analyse": "phpstan analyse --memory-limit=1G"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "process-timeout": 0,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  }
}
