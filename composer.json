{
  "name": "tangible/populater",
  "description": "WordPress plugin to populate a WP site with LMS content for testing and development.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1",
    "deliciousbrains/wp-background-processing": "^1.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "brain/monkey": "^2.6",
    "mockery/mockery": "^1.6",
    "yoast/phpunit-polyfills": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "Tangible\\Populater\\LMS\\": "src/lms/",
      "Tangible\\Populater\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tangible\\Populater\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:integration": "phpunit -c phpunit.integration.xml",
    "docker:test": "docker compose exec wp-test bash -c 'composer test'",
    "docker:test:integration": "docker compose exec wp-test bash -c 'composer test:integration'"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
