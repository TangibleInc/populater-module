{
  "xEnv": {
    "ABORT_ON_USER_POOL_EXHAUSTED": "0"
  },
  "scenarios": {
    "student_journey": {
      "executor": "constant-arrival-rate",
      "exec": "default",
      "rate": 100,
      "timeUnit": "30s",
      "duration": "30s",
      "preAllocatedVUs": 100,
      "maxVUs": 100,
      "gracefulStop": "30m",
      "tags": {
        "workload": "student_journey",
        "profile": "clean-race-100",
        "benchmark_phase": "clean-race"
      }
    }
  },
  "summaryTrendStats": ["avg", "min", "med", "p(90)", "p(95)", "max", "count"],
  "thresholds": {
    "http_req_failed": ["rate<0.05"],
    "http_req_duration": ["p(95)<1000"],
    "checks": ["rate==1.00"],
    "iterations": ["count>0"],
    "group_duration{group:::course}": ["p(95)<3600000"]
  }
}
