# Copy to .env and adjust: cp .env.example .env
#
# Docker Compose loads this file automatically for variable substitution.
# k6 scripts (composer k6:lifter*) also source it.

# -----------------------------------------------------------------------------
# Local WordPress (docker compose up)
# -----------------------------------------------------------------------------

PORT=8888
TESTPORT=8889
TAG=php8.2

# -----------------------------------------------------------------------------
# k6 load tests
# -----------------------------------------------------------------------------

# Target site URL. Examples:
#   http://host.docker.internal:8888                   (local wp from docker k6)
#   https://tangible-bench.tangiblelaunchpad.com       (live bench)
K6_BASE_URL=http://host.docker.internal:8888
K6_USER_PASSWORD=StressTest#2026

# Load profile
K6_VUS=20
K6_MAX_USERS=20
K6_RAMP_UP=1m
K6_HOLD=3m30s
K6_RAMP_DOWN=1m
K6_THINK_TIME=1

# Seeded content (Populater deterministic slugs)
K6_USER_PREFIX=student
K6_COURSE_INDEX=1
K6_LESSON_COUNT=10
K6_SECTION_INDEX=1
K6_QUIZ_INDEX=1
