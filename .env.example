# Copy to .env and adjust: cp .env.example .env
#
# Docker Compose loads this file automatically for variable substitution.
# k6 scripts (composer k6:lifter*, k6:learndash*) also source it.

# -----------------------------------------------------------------------------
# Local WordPress (docker compose up)
# -----------------------------------------------------------------------------

PORT=8888
TESTPORT=8889
TAG=php8.2

# -----------------------------------------------------------------------------
# k6 load tests
# -----------------------------------------------------------------------------

# Target site URL. Examples:
#   http://localhost:8888                              (local WordPress via Docker)
#   https://tangible-bench.tangiblelaunchpad.com       (live bench)
K6_BASE_URL=http://localhost:8888
K6_USER_PASSWORD='StressTest#2026'

# Cloudflare WAF bypass (match Skip rule: UA contains bench2.com OR x-reviewsignal exists)
K6_CF_BYPASS=1
K6_CF_USER_AGENT=bench2.com PopulaterK6/1.0
K6_CF_BYPASS_HEADER=x-reviewsignal
K6_CF_BYPASS_VALUE=1

# Load profile. Profiles live in k6/profiles/*.json.
# VUs, ramp times, and iteration counts come from the profile — do NOT set
# K6_VUS / K6_RAMP_UP / K6_HOLD here unless you intentionally want to override
# the profile for a one-off run (those vars override every profile including smoke).
K6_PROFILE=default

# User pool — must cover the number of seeded students for the chosen profile.
# e.g. bench-100 needs at least 100 seeded students.
K6_MAX_USERS=20

# Seconds between courses in one student journey.
K6_THINK_TIME=1
# Seconds after every student action (page view, click, quiz answer). 1 = realistic pacing.
K6_STEP_THINK_TIME=1

# ── Profile shape overrides (leave commented; set only for one-off CLI runs) ──────
# WARNING: K6_VUS overrides vus: in ALL profiles, including smoke (vus:1).
# Prefer editing the profile JSON or creating a new profile instead.
# K6_SCENARIO=ramping-vus
# K6_VUS=20
# K6_RAMP_UP=1m
# K6_HOLD=20m
# K6_RAMP_DOWN=1m
# K6_GRACEFUL_RAMP_DOWN=30s
# K6_ITERATIONS_PER_VU=1
# K6_MAX_DURATION=30m
# K6_SCENARIO_NAME=student_journey
# Arrival-rate profile overrides (breaking-point-arrival)
# K6_RATE_TARGETS=20,50,100,200,400
# K6_STAGE_DURATION=1m
# K6_PRE_ALLOCATED_VUS=100
# K6_MAX_VUS=500
# K6_RATE_TIME_UNIT=1m
# K6_GRACEFUL_STOP=5m

# Seeded content (Populater deterministic slugs)
# Lifter logins: lifterstudent1 … | LearnDash: ldstudent1 …
K6_COURSE_INDEX=1
# Courses visited per iteration: course-N … course-(N+count-1) (default 5, align with Populater seed)
K6_COURSE_COUNT=5
# When 1, each student only runs their matching course index (ldstudentN → course-N)
K6_COURSE_PER_USER=0
K6_LESSON_COUNT=10
K6_SECTIONS_PER_COURSE=5
K6_QUIZZES_PER_SECTION=1
# LearnDash topics per lesson to mark complete (align with Populater topics_per_lesson)
K6_TOPIC_COUNT=10
K6_QUESTIONS_PER_QUIZ=10
# Topic index where the lesson quiz lives (usually the last topic, e.g. 10)
K6_QUIZ_TOPIC_INDEX=10
# LifterLMS section index (ignored by LearnDash k6 script)
K6_SECTION_INDEX=1
K6_QUIZ_INDEX=1

# Report autosave: HTML dashboard + summary JSON with grouped journey timings
K6_REPORT_AUTOSAVE=1
# Set to 1 for full per-sample NDJSON (multi-GB on long 100-VU runs; default is summary only)
# K6_JSON_STREAM=0
# Live dashboard: http://127.0.0.1:5665 — set K6_WEB_DASHBOARD=0 to disable
K6_WEB_DASHBOARD=1
K6_WEB_DASHBOARD_PORT=5665
K6_API_ADDRESS=127.0.0.1:6566
# Optional fixed HTML path (default: k6/reports/k6-report-<timestamp>.html)
# K6_WEB_DASHBOARD_EXPORT=k6/reports/k6-report.html

# k6 Cloud: when enabled, the regular composer k6:* commands use k6 cloud run.
# K6_EXECUTION=cloud
# K6_CLOUD_TOKEN=
# K6_CLOUD_PROJECT_ID=
# Override k6 cloud login config directory (default: ~/.config/k6)
# K6_HOST_CONFIG_DIR=/home/you/.config/k6
